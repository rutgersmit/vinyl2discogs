# ---------------------------------------------------------------------------
# Required: Discogs personal access token
#   https://www.discogs.com/settings/developers -> "Generate new token"
DISCOGS_TOKEN=

# Required: at least ONE vision backend
#   Claude (Anthropic API)
ANTHROPIC_API_KEY=
#   OpenAI API
OPENAI_API_KEY=
#   a local Ollama server with a vision model, e.g. http://192.168.1.10:11434
OLLAMA_URL=
# ---------------------------------------------------------------------------

# Optional
# claude | openai | ollama. Empty = the first one that is configured, in that order
VISION_PROVIDER=
CLAUDE_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-6.1-terra
# Any endpoint that speaks the OpenAI Responses API
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_MODEL=qwen2.5vl:7b
# Photos are downscaled to this many pixels on the long side before sending
MAX_IMAGE_PX=1568

# Empty = resolved via /oauth/identity
DISCOGS_USERNAME=
# Default collection folder (1 = Uncategorized); can be picked per record in the UI
DISCOGS_FOLDER_ID=1

# Set to enable HTTP Basic auth (any username, this password)
APP_PASSWORD=
WORKER_CONCURRENCY=1
# Number of top candidates fetched in full for runout/matrix comparison
DETAIL_LOOKUPS=8

# Owner of the ./data bind mount on the host (default 1000:1000)
PUID=1000
PGID=1000
