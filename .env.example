# ---------------------------------------------------------------------------
# Required: Discogs personal access token
#   https://www.discogs.com/settings/developers -> "Generate new token"
DISCOGS_TOKEN=

# Required: at least ONE vision backend
#   Claude (best at reading worn labels and hand-etched runouts)
ANTHROPIC_API_KEY=
#   and/or a local Ollama server with a vision model, e.g. http://192.168.1.10:11434
OLLAMA_URL=
# ---------------------------------------------------------------------------

# Optional
# claude | ollama. Empty = claude if ANTHROPIC_API_KEY is set, otherwise ollama
VISION_PROVIDER=
CLAUDE_MODEL=claude-sonnet-5-5
OLLAMA_MODEL=qwen2.5vl:7b
# Photos are downscaled to this many pixels on the long side before sending
MAX_IMAGE_PX=1568

# Empty = resolved via /oauth/identity
DISCOGS_USERNAME=
# Default collection folder (1 = Uncategorized); can be picked per record in the UI
DISCOGS_FOLDER_ID=1

# Set to enable HTTP Basic auth (any username, this password)
APP_PASSWORD=
WORKER_CONCURRENCY=1
# Number of top candidates fetched in full for runout/matrix comparison
DETAIL_LOOKUPS=8
