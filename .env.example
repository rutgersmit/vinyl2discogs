# ---------------------------------------------------------------------------
# Required: Discogs personal access token
#   https://www.discogs.com/settings/developers -> "Generate new token"
DISCOGS_TOKEN=

# Required: at least ONE vision backend
#   Claude (Anthropic API)
ANTHROPIC_API_KEY=
#   OpenAI API
OPENAI_API_KEY=
#   a local Ollama server with a vision model, e.g. http://192.168.1.10:11434
OLLAMA_URL=
# ---------------------------------------------------------------------------

# Optional
# claude | openai | ollama. Empty = the first one that is configured, in that order
VISION_PROVIDER=
CLAUDE_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-6.1-terra
# Any endpoint that speaks the OpenAI Responses API
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_MODEL=qwen2.5vl:7b
# Photos are downscaled to this many pixels on the long side before sending
MAX_IMAGE_PX=1568

# Empty = resolved via /oauth/identity
DISCOGS_USERNAME=
# Default collection folder (1 = Uncategorized); can be picked per record in the UI
DISCOGS_FOLDER_ID=1

# Currency for marketplace prices shown in the app and used by RARE_MIN_PRICE
DISCOGS_CURRENCY=EUR

# Rare-find alerts: the best match is flagged as a possible rare find when ANY of these hits (0 = off)
#   at most this many Discogs users have it
RARE_MAX_HAVE=50
#   want/have ratio of at least this, with at least RARE_MIN_WANT_COUNT wants
RARE_MIN_WANT_RATIO=3
RARE_MIN_WANT_COUNT=25
#   lowest marketplace price at least this (in DISCOGS_CURRENCY)
RARE_MIN_PRICE=100
# Optional: POST a JSON alert here on every rare find (e.g. a Home Assistant webhook)
RARE_WEBHOOK_URL=

# Set to enable HTTP Basic auth (any username, this password)
APP_PASSWORD=
WORKER_CONCURRENCY=1
# Number of top candidates fetched in full for runout/matrix comparison
DETAIL_LOOKUPS=8

# Owner of the ./data bind mount on the host (default 1000:1000)
PUID=1000
PGID=1000
